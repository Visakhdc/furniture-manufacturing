<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finished_product_kanban" model="ir.ui.view">
        <field name="name">finished.product.template.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="type"/>
                <field name="qty_available"/>
                <field name="uom_id"/>
                <field name="list_price"/>
                <field name="categ_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('product.template', 'image_128', record.id.raw_value)"
                                     alt="Product"
                                     class="o_kanban_image_fill_left"
                                     style="width: 100px; height: 100px; object-fit: cover;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="categ_id"/>
                                </div>
                                <ul>
                                    <li>
                                        Price: <field name="list_price" widget="monetary"/>
                                    </li>
                                    <li>
                                        On Hand: <field name="qty_available"/> <field name="uom_id"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_finished_goods_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('sale_ok','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first product
            </p>
        </field>
    </record>

    <menuitem id="menu_finished_goods_template"
              name="Sale Products"
              parent="menu_wood_in_stock"
              action="action_finished_goods_products"
              sequence="11"/>
</odoo>